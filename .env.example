# Copie para .env, ao lado de manage.py. Nunca publique o .env real.
# Para usar o SQLite existente, troque mysql por sqlite.
DB_ENGINE=mysql
DB_NAME=biblioteca
DB_USER=biblioteca_app
# Defina aqui a mesma senha configurada para esse usuário no MySQL.
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Configuração para estudo local. Antes de publicar, consulte o README.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
